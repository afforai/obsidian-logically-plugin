{
  "name": "obsidian-logically-plugin",
  "version": "0.3.0",
  "description": "AI-powered research assistant for Obsidian, integrated with Logically (logically.app)",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:install": "pnpm run build && node scripts/dev-install.js",
    "dev:watch": "concurrently -k \"pnpm dev\" \"chokidar 'main.js' 'styles.css' -c 'pnpm dev:install'\"",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "logically",
    "research",
    "ai"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "0.25.5",
    "esbuild-svelte": "^0.8.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jiti": "2.6.1",
    "nano-staged": "^0.9.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "rollup": "^4.30.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.2",
    "svelte": "^4.2.19",
    "svelte-preprocess": "^6.0.3",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.50.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.17",
    "obsidian": "latest"
  },
  "nano-staged": {
    "*.{ts,svelte,json,md}": "prettier --write",
    "*.ts": "eslint --max-warnings 0"
  }
}
